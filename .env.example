# Copy this file to `.env` and fill in values for LOCAL development.
# Never commit `.env`. In production these are set in Vercel → Project → Environment Variables.

# OAuth 2.0 web client id (public by design) — used for the owner "Connect Google Calendar" flow
GOOGLE_CLIENT_ID=

# Google Cloud API key (domain-restricted) — used to read a public/shared calendar's busy times
GOOGLE_API_KEY=

# Calendar id to query, e.g. 'primary' (your main a76roshanzamir@gmail.com calendar)
GOOGLE_CALENDAR_ID=primary